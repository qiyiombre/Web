# Copy this file to .env and fill your own values.
# Never commit .env because it contains private keys.
PORT=3001
DATABASE_URL=postgresql://postgres.project-ref:password@host:6543/postgres
ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=15000
